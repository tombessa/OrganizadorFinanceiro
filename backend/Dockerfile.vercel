FROM maven:3.9.11-eclipse-temurin-21-alpine AS build
WORKDIR /workspace
COPY pom.xml .
RUN mvn -B -q dependency:go-offline
COPY src src
COPY docker docker
RUN sh docker/test-database-url.sh
RUN mvn -B -q clean verify

FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S app && adduser -S app -G app
RUN mkdir -p /var/lib/organizador-financeiro/imports \
    && chown -R app:app /var/lib/organizador-financeiro
WORKDIR /app
COPY --from=build /workspace/target/backend-0.1.0-SNAPSHOT.jar app.jar
COPY --from=build /workspace/docker/database-url.sh /app/database-url.sh
COPY --from=build /workspace/docker/entrypoint.sh /app/entrypoint.sh
RUN chmod 0555 /app/database-url.sh /app/entrypoint.sh
USER app
EXPOSE 80
CMD ["/app/entrypoint.sh"]
